<?xml version="1.0" encoding="UTF-8"?>
<!--
	Deployment configuration for Obot Sentry, delivered as managed
	preferences. Obot renders the server URL and scan interval into this
	profile; the admin replaces REPLACE_WITH_ENROLLMENT_KEY before
	uploading it, so the enrollment key never passes through obot's
	rendering.

	The profile lands at /Library/Managed Preferences/ai.obot.obot-sentry.plist,
	which pkg/mdmconfig reads ahead of the /Library/Preferences fallback the
	DIY channel writes - so a pushed profile always wins over local edits.

	UUIDs are stable across releases (MDMs dedupe on PayloadIdentifier). To
	change a value later, edit it, bump PayloadVersion on the inner and outer
	payloads, and re-upload: devices pick it up on the next profile sync with
	no reinstall.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDescription</key>
			<string>Obot server URL, enrollment key, and scan interval for the Obot Sentry device agent.</string>
			<key>PayloadDisplayName</key>
			<string>Obot Sentry - Managed Settings</string>
			<key>PayloadIdentifier</key>
			<string>ai.obot.obot-sentry.config.settings</string>
			<key>PayloadType</key>
			<string>com.apple.ManagedClient.preferences</string>
			<key>PayloadUUID</key>
			<string>A4DD29A9-C776-4B0D-A6F9-B0B663E4FE23</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadContent</key>
			<dict>
				<key>ai.obot.obot-sentry</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>ServerURL</key>
								<string>{{.serverURL | html}}</string>
								<key>EnrollmentKey</key>
								<string>REPLACE_WITH_ENROLLMENT_KEY</string>
								<key>ScanIntervalMinutes</key>
								<integer>{{.scanIntervalMinutes}}</integer>
							</dict>
						</dict>
					</array>
				</dict>
			</dict>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Configures the Obot Sentry device agent: the Obot server it reports to, the enrollment key it authenticates with, and how often each signed-in user submits a scan. Replace REPLACE_WITH_ENROLLMENT_KEY before uploading.</string>
	<key>PayloadDisplayName</key>
	<string>Obot Sentry - Configuration</string>
	<key>PayloadIdentifier</key>
	<string>ai.obot.obot-sentry.config</string>
	<key>PayloadOrganization</key>
	<string>Obot</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>624F8E0C-E703-4703-AAC4-97E23AE3A3D7</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
